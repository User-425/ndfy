# Server Configuration
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
TRUST_PROXY=false

# Database Configuration
DATABASE_PATH=./data/ndfy.db

# Message Configuration
MESSAGE_CACHE_TTL=43200
MESSAGE_SIZE_LIMIT=4096
KEEPALIVE_INTERVAL=45
CLEANUP_INTERVAL=300

# Authentication (modes: 'none' | 'token')
AUTH_MODE=none
AUTH_TOKENS=

# Rate Limiting
RATE_LIMIT_PUBLISH=60
RATE_LIMIT_SUBSCRIBE=120

# Upstream Push Notification (ntfy upstream wakeup)
UPSTREAM_ENABLED=false
UPSTREAM_BASE_URL=https://ntfy.sh
UPSTREAM_ACCESS_TOKEN=
